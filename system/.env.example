# ===== 航运信息系统 环境变量示例 =====
# 使用方式：复制本文件为 .env 并填入真实值
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git。

# --- Django ---
# 密钥（参与密码加盐，更换后已注册用户密码会失效，需重置）
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- 数据库（默认 MySQL） ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=django
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
# 如需零配置的 SQLite，将 DB_ENGINE 改为 django.db.backends.sqlite3 即可。

# --- MongoDB（新闻资讯数据，可选） ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=news_db
MONGODB_COLLECTION=news_collection

# --- Neo4j（知识图谱，密码至少 8 位，可选） ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- DeepSeek / OpenAI 兼容接口（问答大模型，可选） ---
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
